# Supabase — used by the Contact page (place_order RPC), the online checkout
# (place_online_order RPC) and the back-office (admin login + data).
#
# The anon key is public by design: it ships to every browser and is gated by
# row level security. NEVER put the service_role key in a VITE_ variable —
# it would ship to every browser too.
#
# Local development: copy this file to .env.local and fill the values printed
# by `supabase status`. Without these variables the site silently keeps its
# WhatsApp-only behaviour.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Online payment methods offered at checkout, comma-separated: cash, mtn, orange.
# Keep "cash" only until the matching Edge Function secrets are configured
# (see README → Paiement en ligne), then add "mtn" and/or "orange".
VITE_PAYMENT_METHODS=cash

# ──────────────────────────────────────────────────────────────────────────
# Edge Function secrets — NOT Vite variables. Set them with:
#   supabase secrets set --env-file ./supabase/.env.functions
# (or one `supabase secrets set KEY=value` per line). See README.
#
# Site
SITE_URL=https://mialinegiftedhands.com
#
# Notifications (email via Resend — free up to 100/day)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Mialine Gifted Hands <onboarding@resend.dev>
NOTIFY_EMAIL_TO=
#
# Notifications (SMS via Termii — optional, paid per SMS)
TERMII_API_KEY=
TERMII_SENDER_ID=Mialine
NOTIFY_SMS_TO=
#
# MTN MoMo Collections (sandbox first: https://momodeveloper.mtn.com)
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
# Production (Cameroon): MTN_BASE_URL per the market onboarding,
# MTN_TARGET_ENVIRONMENT as given by MTN, MTN_CURRENCY=XAF.
#
# Orange Money Web Payment (sandbox first: https://developer.orange.com)
ORANGE_BASE_URL=https://api.orange.com
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_COUNTRY_CODE=dev
ORANGE_CURRENCY=XAF
# Production (Cameroon): ORANGE_COUNTRY_CODE=cm.
